{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Hangfire": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "Origins": []
  },
  "//": "Shape only. Real values come from environment variables in staging and production: Storage__Endpoint, Storage__AccessKey, Storage__SecretKey, Storage__Bucket, Auth__DeviceToken, Stt__Azure__Key, Stt__Azure__Region, Anthropic__ApiKey, Hangfire__DashboardUser, Hangfire__DashboardPassword. Startup fails if the storage and auth ones are missing; the AI keys deliberately do not stop the host, they park entries in needs_review.",
  "Storage": {
    "Endpoint": "",
    "PublicEndpoint": "",
    "AccessKey": "",
    "SecretKey": "",
    "Bucket": "",
    "Region": "us-east-1",
    "ForcePathStyle": true,
    "UploadUrlTtl": "00:15:00",
    "DownloadTimeout": "00:02:00",
    "DownloadRetries": 0
  },
  "Auth": {
    "DeviceToken": ""
  },
  "Stt": {
    "Azure": {
      "Key": "",
      "Region": "",
      "FastApiVersion": "2024-11-15",
      "RequestTimeout": "00:02:00"
    }
  },
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-5",
    "MaxTokens": 4000,
    "RequestTimeout": "00:03:00"
  },
  "Pipeline": {
    "MaxAttempts": 3,
    "RetryDelay": "00:00:02",
    "StaleProcessingAfter": "00:45:00",
    "SweepInterval": "00:01:00",
    "SweepBatchSize": 50,
    "TranscriptionLocale": "sr-RS"
  },
  "Hangfire": {
    "Enabled": true,
    "WorkerCount": 4,
    "DashboardUser": "",
    "DashboardPassword": ""
  }
