<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Roadmap A1: throwaway benchmark harness. Deliberately self-contained — it references no
    Teren project and nothing under src/ may reference it, so it can be deleted in one command
    once A3 has picked a provider.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SttSpike</RootNamespace>
    <AssemblyName>SttSpike</AssemblyName>
    <UserSecretsId>teren-stt-spike</UserSecretsId>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CognitiveServices.Speech" Version="1.51.2" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.11" />
    <!-- Audio decode/resample without ffmpeg: NAudio wraps Windows Media Foundation (m4a/mp3/
         wma) and supplies the WDL resampler; Concentus is a pure-managed Ogg/Opus decoder. -->
    <PackageReference Include="NAudio" Version="3.0.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="Concentus.Oggfile" Version="1.0.7" />
  </ItemGroup>

</Project>
