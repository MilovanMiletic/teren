# Teren — deployment configuration. Copy to deploy/.env and fill in.
#
#   cp deploy/.env.example deploy/.env
#
# deploy/.env is gitignored (.gitignore covers `.env` and `.env.*`, with `.env.example` excepted).
# NOTHING in this file has a value. If you find a real credential in a file tracked by git, that
# credential is burned — rotate it, do not just delete the line.
#
# Every value below arrives in the container as an environment variable. There is no second
# place to look: appsettings.json carries the *shape*, this file carries the truth, and
# appsettings.Development.json exists only for a laptop.

# ---------------------------------------------------------------------------- identity of the box
# Compose project name. Keep it different from the development stack's (`teren`) so the two can
# never share a volume.
TEREN_STACK=teren-prod

# The public hostname. It must be a name you control DNS for, pointed at this box's IP, before
# the first deploy — Caddy proves ownership over ACME and cannot get a certificate otherwise.
TEREN_DOMAIN=
# Where Let's Encrypt sends expiry and renewal-failure warnings. Optional but do set it.
TEREN_ACME_EMAIL=

# The exact origin the PWA is served from, used when applying bucket CORS. Normally
# https://$TEREN_DOMAIN, with no trailing slash.
TEREN_APP_ORIGIN=

TEREN_TZ=Europe/Belgrade

# ---------------------------------------------------------------------------------- deploy target
# Where deploy.sh ships to. Anything ssh understands: user@host, or a Host alias from ~/.ssh/config.
TEREN_SSH_HOST=
# Absolute path on that host where the deploy directory and env file live.
TEREN_REMOTE_DIR=/opt/teren

# Image tags. Leave as-is unless you introduce a registry.
TEREN_API_IMAGE=teren-api:local
TEREN_WEB_IMAGE=teren-web:local

# ---------------------------------------------------------------------------------------- database
TEREN_DB_NAME=teren
TEREN_DB_USER=teren
# Generate: openssl rand -base64 24
TEREN_DB_PASSWORD=

# --------------------------------------------------------------------------------- object storage
# TWO endpoints, and confusing them is the single most expensive mistake in this file.
#
#   TEREN_STORAGE_ENDPOINT         what the API container talks to (HEAD verification, report
#                                  upload, media download for the pipeline). May be internal.
#   TEREN_STORAGE_PUBLIC_ENDPOINT  what gets BAKED INTO the presigned URLs the phone uses. The
#                                  host is part of what SigV4 signs, so this must be exactly the
#                                  address the phone will call, over https.
#
# Leave PUBLIC empty only when both are the same address. Get it wrong and uploads fail from the
# phone while everything on the server looks healthy — and it presents as a CORS error, because
# the browser's complaint about an unreachable or unsigned host looks the same as a preflight
# refusal. See deploy/README.md, "Uploads fail and it looks like CORS".
TEREN_STORAGE_ENDPOINT=
TEREN_STORAGE_PUBLIC_ENDPOINT=
TEREN_STORAGE_ACCESS_KEY=
TEREN_STORAGE_SECRET_KEY=
TEREN_STORAGE_BUCKET=
TEREN_STORAGE_REGION=
# true for MinIO and most S3-compatible stores, including Hetzner Object Storage.
TEREN_STORAGE_FORCE_PATH_STYLE=true
# Docker network apply-cors.sh joins so mc can reach the endpoint. `bridge` for a public
# endpoint; the stack's own network name when the store is inside the compose project.
TEREN_STORAGE_DOCKER_NETWORK=

# ------------------------------------------------------------------------------------------- auth
# The DEMO DEVICE's token, and nothing else (ARCHITECTURE §12). OPTIONAL — leave it empty.
#
# It had two homes until D7/F9 (2026-08-31): this variable, and a string compiled into the PWA
# bundle. The second one is gone. The bundle carries no credential, deploy/web.Dockerfile
# substitutes nothing, and a phone earns its own token at /auth/activate with a username and a
# one-time code.
#
# What is left is one row: `seed` provisions a device for the demo worker whose token_hash is
# SHA-256 of this value. Empty means "provision no demo device" — a perfectly good host, which
# says so once at start-up. Set it only if you want that one phone to work without activating it,
# and generate it (openssl rand -hex 32): a value anyone else knows is a working credential to the
# demo company. Minimum 16 characters when set at all.
TEREN_DEVICE_TOKEN=

# ---------------------------------------------------------------------------------- AI providers
# Their absence does not stop the host: entries park in needs_review with an honest reason
# (ARCHITECTURE §4). Their absence does stop the product from doing anything useful.
TEREN_STT_AZURE_KEY=
TEREN_STT_AZURE_REGION=
TEREN_ANTHROPIC_API_KEY=

# -------------------------------------------------------------------------------- report delivery
# NEVER port 25 from the VPS: Hetzner blocks outbound 25 by default and a fresh VPS IP has no
# sending reputation, so the report that IS the product lands in spam (ARCHITECTURE §10). Use an
# authenticated relay on 587/StartTls or 465/SslOnConnect, and publish SPF, DKIM and DMARC for
# the TEREN_REPORT_FROM_ADDRESS domain.
#
# On a staging box with no relay chosen yet, set TEREN_SMTP_HOST=mailpit and run the stack with
# the `mailcatcher` profile: every report is captured and readable, and none of it goes anywhere.
TEREN_REPORT_FROM_ADDRESS=
TEREN_REPORT_FROM_NAME=Teren
TEREN_REPORT_REPLY_TO=
TEREN_SMTP_HOST=
TEREN_SMTP_PORT=587
TEREN_SMTP_SECURITY=StartTls
TEREN_SMTP_USERNAME=
TEREN_SMTP_PASSWORD=

# --------------------------------------------------------------------------------- jobs dashboard
# Without both of these the Hangfire dashboard is unreachable rather than open — it serves
# loopback only when unconfigured, and behind a proxy nothing is loopback. Set them if you want
# to see the job queue at https://$TEREN_DOMAIN/hangfire.
TEREN_HANGFIRE_USER=
TEREN_HANGFIRE_PASSWORD=

# ---------------------------------------------------------------------------------------- backups
# Local directory on the host that nightly dumps are written to.
TEREN_BACKUP_DIR=/var/backups/teren
# Days of dumps to keep, on the host and in object storage.
TEREN_BACKUP_RETENTION_DAYS=30
# Bucket for off-box copies. Leave empty to keep dumps on the box only — which means one disk
# failure loses both the database and its backups, so do not leave it empty for long.
TEREN_BACKUP_BUCKET=

# -------------------------------------------------------------------------- published port mapping
# Whole mappings, host:container. Defaults are the real ones; the local rehearsal overrides them.
TEREN_HTTP_PUBLISH=80:80
TEREN_HTTPS_PUBLISH=443:443
TEREN_HTTPS_PUBLISH_UDP=443:443/udp
# Which Caddy config the web container mounts. ./Caddyfile in production.
TEREN_CADDYFILE=./Caddyfile
